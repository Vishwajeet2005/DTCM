# Database
DATABASE_URL=sqlite:///dtcm.db
# For MySQL: DATABASE_URL=mysql+pymysql://user:password@localhost/dtcm_db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Weather API (optional)
OPENWEATHERMAP_API_KEY=your-key-here
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# IoT Sensor API (optional - falls back to synthetic data)
SENSOR_API_BASE_URL=http://your-iot-gateway/api/sensors
SENSOR_POLL_INTERVAL_SECONDS=60

# Alert thresholds (ppm)
CO2_WARNING_THRESHOLD=450
CO2_CRITICAL_THRESHOLD=500

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-password
ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com

# Model settings
MODEL_RETRAIN_INTERVAL_DAYS=30
MIN_ACCEPTABLE_R2=0.80

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=flask-secret-key-change-in-production
